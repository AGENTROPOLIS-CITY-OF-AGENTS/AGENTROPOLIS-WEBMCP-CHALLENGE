{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/contracts/parallax-denial-receipt.schema.json",
  "title": "PARALLAX Denial Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_type",
    "request_id",
    "request_hash",
    "actor_identity",
    "requested_capability",
    "target",
    "policy_snapshot_hash",
    "decision",
    "reason_code",
    "decision_timestamp",
    "dispatch_state",
    "denying_authority",
    "signature",
    "audit_commitment"
  ],
  "properties": {
    "receipt_type": { "const": "DENIAL_RECEIPT" },
    "request_id": { "type": "string", "minLength": 1 },
    "request_hash": { "type": "string", "minLength": 1 },
    "actor_identity": { "type": "string", "minLength": 1 },
    "requested_capability": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "policy_snapshot_hash": { "type": "string", "minLength": 1 },
    "decision": { "const": "DENY" },
    "reason_code": { "type": "string", "minLength": 1 },
    "decision_timestamp": { "type": "string", "format": "date-time" },
    "dispatch_state": { "const": "NOT_DISPATCHED" },
    "denying_authority": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 },
    "audit_commitment": { "type": "string", "minLength": 1 }
  }
}