{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/decision.schema.json",
  "title": "AGENTROPOLIS Governance Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "requestId", "effect", "reasons", "decidedAt"],
  "properties": {
    "decisionId": {"type": "string", "minLength": 8},
    "requestId": {"type": "string", "minLength": 8},
    "effect": {"enum": ["ALLOW", "DENY", "REQUIRE_APPROVAL"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "policyVersion": {"type": "string"},
    "decidedAt": {"type": "string", "format": "date-time"}
  }
}
